 impl State {
+    pub(crate) fn sample_window_pixels(
+        &mut self,
+        id: u64,
+    ) -> anyhow::Result<(Size<i32, Physical>, Vec<u8>)> {
+        let niri = &self.niri;
+        ensure!(
+            matches!(niri.lock_state, LockState::Unlocked) && niri.monitors_active,
+            "window capture unavailable while locked, locking or blanked"
+        );
+        ensure!(
+            !matches!(&self.backend, Backend::Tty(tty) if !tty.session_active()),
+            "window capture unavailable on an inactive seat"
+        );
+        let (monitor, mapped) = niri
+            .layout
+            .windows()
+            .find(|(_, mapped)| mapped.id().get() == id)
+            .context("window no longer mapped")?;
+        let output = monitor.context("window has no output")?.output();
+        let config = niri.config.borrow();
+        let target_rules = ResolvedWindowRules::compute_with_cast_target(
+            &config.window_rules,
+            WindowRef::Mapped(mapped),
+            niri.is_at_startup,
+            true,
+        );
+        // Include the ordinary rules as well as those for an active cast target.
+        // A pending rule recalculation must never create a gap in privacy.
+        let current_rules = ResolvedWindowRules::compute(
+            &config.window_rules,
+            WindowRef::Mapped(mapped),
+            niri.is_at_startup,
+        );
+        ensure!(
+            mapped.rules().block_out_from.is_none()
+                && current_rules.block_out_from.is_none()
+                && target_rules.block_out_from.is_none(),
+            "window is protected by a capture rule"
+        );
+
+        // Render the most recently committed surfaces, including the window's own popups,
+        // into an initially transparent target. No output contents or pointer are used.
+        let bbox = mapped.window.bbox_with_popups();
+        let edge = bbox.size.w.max(bbox.size.h);
+        ensure!(bbox.size.w > 0 && bbox.size.h > 0, "empty window");
+        let scale = Scale::from(
+            output
+                .current_scale()
+                .fractional_scale()
+                .min(1920. / f64::from(edge)),
+        );
+        let size = bbox.to_physical_precise_up(scale).size;
+        ensure!(
+            (1..=1920).contains(&size.w) && (1..=1920).contains(&size.h),
+            "invalid window size"
+        );
+        self.backend
+            .with_primary_renderer(|renderer| {
+                let mut elements = Vec::new();
+                mapped.render_for_screen_cast(renderer, scale, &mut |elem| elements.push(elem));
+                ensure!(!elements.is_empty(), "window has no committed content");
+                let pixels = render_to_vec(
+                    renderer,
+                    size,
+                    scale,
+                    Transform::Normal,
+                    Fourcc::Abgr8888,
+                    elements.into_iter().rev(),
+                )?;
+                Ok((size, pixels))
+            })
+            .context("window renderer unavailable")?
+    }
