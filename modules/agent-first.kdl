layout {
    gaps 8
    focus-ring {
        width 3
        active-color "#71c4ac"
    }
}
binds {
    Super+Space hotkey-overlay-title="System actions" { spawn "weasel" "palette"; }
    Super+D hotkey-overlay-title="Applications" { spawn "fuzzel"; }
    Super+Return hotkey-overlay-title="Terminal" { spawn "foot"; }
    Super+E hotkey-overlay-title="Text editor" { spawn "mousepad"; }
    Super+F1 hotkey-overlay-title="Keyboard shortcuts" { show-hotkey-overlay; }
    Alt+Escape allow-inhibiting=false hotkey-overlay-title="Stop agent input" { spawn "@cancel@"; }
    Ctrl+Alt+Escape allow-inhibiting=false hotkey-overlay-title="Take control of desktop" { spawn "weasel-computer-use" "call" "desktop_takeover" "{}"; }
    Super+Shift+A hotkey-overlay-title="Allow desktop control" { spawn "weasel" "resume-desktop"; }
    Super+Left { focus-column-left; }
    Super+Right { focus-column-right; }
    Super+Up { focus-window-up; }
    Super+Down { focus-window-down; }
    Super+Page_Up { focus-workspace-up; }
    Super+Page_Down { focus-workspace-down; }
    Super+Shift+Page_Up { move-column-to-workspace-up; }
    Super+Shift+Page_Down { move-column-to-workspace-down; }
    Super+Shift+Left { move-column-left; }
    Super+Shift+Right { move-column-right; }
    Super+W { close-window; }
    Super+F { maximize-column; }
    Super+Shift+F { fullscreen-window; }
    Super+Tab { toggle-overview; }
    Super+Shift+E { quit; }
}
