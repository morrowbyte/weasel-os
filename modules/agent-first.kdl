layout {
    gaps 8
    focus-ring {
        width 3
        active-color "#71c4ac"
    }
}
binds {
    Mod+Space hotkey-overlay-title="System actions" { spawn "weasel" "palette"; }
    Mod+D hotkey-overlay-title="Applications" { spawn "fuzzel"; }
    Mod+Return hotkey-overlay-title="Terminal" { spawn "foot"; }
    Mod+E hotkey-overlay-title="Text editor" { spawn "mousepad"; }
    Mod+F1 hotkey-overlay-title="Keyboard shortcuts" { show-hotkey-overlay; }
    Alt+Escape allow-inhibiting=false hotkey-overlay-title="Stop agent input" { spawn "@cancel@"; }
    Ctrl+Alt+Escape allow-inhibiting=false hotkey-overlay-title="Take control of desktop" { spawn "weasel-computer-use" "call" "desktop_takeover" "{}"; }
    Mod+Left { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up { focus-window-up; }
    Mod+Down { focus-window-down; }
    Mod+Page_Up { focus-workspace-up; }
    Mod+Page_Down { focus-workspace-down; }
    Mod+Shift+Page_Up { move-column-to-workspace-up; }
    Mod+Shift+Page_Down { move-column-to-workspace-down; }
    Mod+Shift+Left { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+W { close-window; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+Tab { toggle-overview; }
    Mod+Shift+E { quit; }
}
